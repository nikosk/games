[
  {
    "file": "voice-0.mp3",
    "text": "Πάμε για πικνίκ!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-1.mp3",
    "text": "Ας απλώσουμε το τραπεζομάντιλο!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-2.mp3",
    "text": "Πάμε να βρούμε τους φίλους μας!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-3.mp3",
    "text": "Πώς θα περάσουμε;",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-4.mp3",
    "text": "Ας βάλουμε τη σανίδα πάνω από το νερό.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-5.mp3",
    "text": "Τώρα μπορούμε να περάσουμε!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-6.mp3",
    "text": "Θέλω ένα μαλακό κρεβατάκι.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-7.mp3",
    "text": "Βάλε τα φύλλα εδώ.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-8.mp3",
    "text": "Τι μαλακό κρεβατάκι!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-9.mp3",
    "text": "Πάρε το καλαθάκι μου!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-10.mp3",
    "text": "Η μπάλα μου! Δεν τη φτάνω!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-11.mp3",
    "text": "Ας δοκιμάσουμε την απόχη.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-12.mp3",
    "text": "Η μπάλα μου! Ευχαριστώ!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-13.mp3",
    "text": "Τα μήλα είναι εκεί πάνω!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-14.mp3",
    "text": "Ας φέρουμε το κουτί κάτω από το κλαδί.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-15.mp3",
    "text": "Πού θα πέσουν τα μήλα;",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-16.mp3",
    "text": "Ας βάλουμε το καλαθάκι από κάτω.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-17.mp3",
    "text": "Ο σκαντζόχοιρος έχει ένα καλαθάκι. Πάμε να τον βοηθήσουμε!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-18.mp3",
    "text": "Ένα μήλο στο κεφάλι σου!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-19.mp3",
    "text": "Θα φέρω εγώ τα μήλα!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-20.mp3",
    "text": "Ένα πιάτο για τον καθένα.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-21.mp3",
    "text": "Ένα μήλο για τον καθένα.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-22.mp3",
    "text": "Καλή όρεξη!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-23.mp3",
    "text": "Πάμε να παίξουμε!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-24.mp3",
    "text": "Ας δοκιμάσουμε κάτι άλλο.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-25.mp3",
    "text": "Η σανίδα και η απόχη είναι στο σπιτάκι.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-26.mp3",
    "text": "Διάλεξε ένα μονοπάτι!",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-27.mp3",
    "text": "Πάτησε ένα πιάτο και μετά μια άδεια θέση.",
    "voice": "el-GR-AthinaNeural"
  },
  {
    "file": "voice-28.mp3",
    "text": "Πάτησε ένα μήλο και μετά ένα πιάτο.",
    "voice": "el-GR-AthinaNeural"
  }
]